{
  "expo": {
    "name": "RowDay",
    "slug": "rowday",
    "scheme": "rowday",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a3a5c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.brightoncrew.rowday"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a3a5c"
      },
      "package": "org.brightoncrew.rowday"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1a3a5c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
